{
  "name": "t3-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Showcase website for NSU CSE499B Section 13 Group 5: offline disaster damage mapping from satellite image pairs",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-data.ts public/data",
    "facts": "node scripts/check-facts.ts",
    "palette": "node scripts/check-palette.ts",
    "selfcheck": "node scripts/selfcheck.ts",
    "fixtures": "node scripts/make-fixtures.ts && node scripts/validate-data.ts fixtures/data --fixtures",
    "prebuild": "npm run validate && npm run facts && npm run guidelines && npm run palette && npm run selfcheck",
    "guidelines": "node scripts/make-guidelines.ts --check",
    "build": "vite build",
    "build:fixtures": "node scripts/validate-data.ts fixtures/data --fixtures && vite build --mode fixtures --outDir dist-fixtures",
    "preview": "vite preview",
    "preview:fixtures": "vite preview --outDir dist-fixtures",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "browser-check": "node scripts/browser-check.ts",
    "deploy:check": "node scripts/check-facts.ts --strict && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.0.0",
    "@fontsource-variable/dm-sans": "^5.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.0.0",
    "@fontsource-variable/source-serif-4": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.17.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0"
  }
}
